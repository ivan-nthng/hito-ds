{
  "name": "hito-ds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "storybook": "npm run storybook --workspace=@hito-ds/storybook",
    "build": "npm run build --workspace=@hito-ds/storybook",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run --config vitest.config.ts",
    "test:stories": "npm run test --workspace=@hito-ds/storybook",
    "validate:tokens": "npm run validate:tokens --workspace=@hito-ds/react",
    "check": "npm run typecheck && npm test && npm run validate:tokens && npm run build"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
